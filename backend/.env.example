APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sri_website
PUBLIC_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000
TRUST_PROXY=0
# Optional absolute directories. Defaults are backend/uploads and frontend/dist.
MEDIA_DIR=
DIST_DIR=
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INBOX_GENERAL=
INBOX_VENTURES=
INBOX_CONSULTING=
INBOX_PARTNERSHIPS=

# Optional integrations. Leave blank to keep them off.
NEWSLETTER_KEY=
GA4_ID=
SEARCH_VERIFICATION=

# Cloudflare Turnstile (secret is server-side only).
TURNSTILE_SECRET_KEY=
